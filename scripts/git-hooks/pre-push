#!/usr/bin/env bash
#
# scripts/git-hooks/pre-push — push 前秘密掃描 + 保護分支守衛
#
# 做兩件事:
#   1. **本機 gitleaks**:CI 抓到時密鑰已離開這台機器 → push 前在本機掃才是第一層。
#      當專案的生產密鑰在 repo 內走 env 變數(Supabase service_role、OAuth secret、
#      DB URL 等)、CI 抓到時已離機,這第一道就是唯一能擋住的地方。
#   2. **保護分支守衛**:Admin push 保護分支會 bypass branch protection,訊息看起來
#      像錯誤但其實已經成功。
#
# 🔴 幾個修過的 P1 洞:
#   ① **逐 ref 掃「這次真的會離機的範圍」**(先收完 stdin,再對每個 ref 掃
#      `remote_sha..local_sha`)。
#      ⚠️ 注意:gitleaks 預設掃 repo 內所有 ref,舊寫法**其實不會漏**——但這個
#      改動的意義是把掃描範圍**對準**這次要離機的 commit:
#        · 快(只掃 push 範圍,不是每次都全史)
#        · 不會因為「本機另一個分支有 finding」而擋掉一個乾淨的 push
#        · 語意誠實:hook 的職責是「別讓密鑰離機」,那就掃離機的那些 commit
#      代價(刻意接受):已經在遠端的舊 leak 不會每次 push 都再擋一次——CI 的全史
#      掃描仍會擋 PR,那才是清理 history 的正確場合。
#   ② **gitleaks 的自助放行**:`gitleaks:allow` 行內註解與 `.gitleaksignore` 都能讓
#      提交者自己放行(官方 escape hatch)→ 加 `--ignore-gitleaks-allow` 且把 ignore
#      檔指到 `/dev/null`,放行一律只走版控的 `.gitleaks.toml`(那份現在也算 code、
#      要走 PR)。
#   ③ **沒裝 gitleaks 就放行**:與「密鑰不離機」相反 → 改 fail-closed,要繞得明確設
#      `SKIP_GITLEAKS_CHECK=1`(或 `--no-verify`)。
#   ④ **刪除保護分支被無條件跳過** + force-push 可能因端點 diff 為空/docs-only 而
#      放行 → 刪除保護分支直接硬擋;非 fast-forward 一律要求確認。
#   ⑤ pre-push 完全沒套 PROTECTED_DOCS(策略/安全/SOP/ADR)→ 現在共用 SSOT 並套用。
#
# Hook 行為:
#   - 先掃這次要離機的所有 commit;有 leak → 硬 block
#   - push target 不是 develop / main → 放行(feature/* 都正常)
#   - 刪除 develop / main → **硬 block**
#   - push target 是 develop / main 但這批 commit 只動純說明文字(且不含
#     PROTECTED_DOCS)→ 放行(對應 progress / TODOS / LESSONS 收尾慣例)
#   - 其餘(含 code、含 PROTECTED_DOCS、新建保護分支、非 fast-forward、diff 取不到)
#     → 要求打字 yes 確認
#
# 緊急逃生:`git push --no-verify`
# Opt-in:`npm run setup-hooks`(設 git config core.hooksPath)

# `set -u`:見 pre-commit 同段——SSOT 變數被改名時,只有 `set -e` 會讓兩支 hook
# 靜默放行。壞掉的守門必須擋。
set -eu

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/git-hooks/code-pattern.sh
. "$HOOK_DIR/code-pattern.sh"

: "${NON_CODE_PATTERN:?code-pattern.sh 沒有定義 NON_CODE_PATTERN(守門失效,拒絕放行)}"
: "${PROTECTED_DOCS:?code-pattern.sh 沒有定義 PROTECTED_DOCS(守門失效,拒絕放行)}"

z40='0000000000000000000000000000000000000000'

# ── 先把 stdin 全部收進來 ────────────────────────────────────────────────
# Git 透過 stdin 傳 "<local-ref> <local-sha> <remote-ref> <remote-sha>",一行一個 ref。
# gitleaks 要按 ref 掃,所以不能邊讀邊處理(洞 ①)。
REF_LINES=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  REF_LINES+=("$local_ref $local_sha $remote_ref $remote_sha")
done

[ ${#REF_LINES[@]} -eq 0 ] && exit 0

# ── 1. 本機秘密掃描(只掃這次會離機的 commit 範圍)──────────────────────
SCAN_RANGES=()
for line in "${REF_LINES[@]}"; do
  # shellcheck disable=SC2086  # 刻意讓空白切成四個位置參數
  set -- $line
  _local_sha="$2"
  _remote_sha="$4"
  [ "$_local_sha" = "$z40" ] && continue # 刪除 ref:沒有新 commit 離機
  if [ "$_remote_sha" = "$z40" ] || ! git cat-file -e "${_remote_sha}^{commit}" 2>/dev/null; then
    # 新 ref,或 remote_sha 的 object 不在本機(stale / force)→ 掃整條 ancestry(從嚴)
    SCAN_RANGES+=("$_local_sha")
  else
    SCAN_RANGES+=("${_remote_sha}..${_local_sha}")
  fi
done

if [ ${#SCAN_RANGES[@]} -gt 0 ]; then
  # 🔴 攻擊 vector 擋(Codex R1 P1):push 範圍同批修改 `.gitleaks.toml` /
  #    `.gitleaksignore` → 直接硬擋。gitleaks 沒指定 `--config` 時會讀當前工作
  #    樹的 `.gitleaks.toml`,攻擊者可在 feature branch 一個 commit 加寬 allowlist
  #    再加密鑰 → gitleaks 依放寬後的 config 放行、密鑰隨 push feature 離機。
  #    修法:合法情境是「先 push .gitleaks.toml 走 PR 合入 protected branch、再
  #    push 這批 commit」;拒絕同批 push 就切斷這條 vector。
  for range in "${SCAN_RANGES[@]}"; do
    if config_touched=$(git log --format= --name-only --no-renames "$range" 2>/dev/null | \
      grep -E '^(\.gitleaks\.toml|\.gitleaksignore)$' || true); [ -n "$config_touched" ]; then
      {
        echo ""
        echo "✗ push 範圍 $range 同批修改 gitleaks 設定,擋下 push"
        echo "   影響檔案:"
        while IFS= read -r f; do
          [ -n "$f" ] && echo "     - $f"
        done <<< "$config_touched"
        echo ""
        echo "   同批放寬 allowlist ＋加密鑰是已知攻擊 vector(feature branch push"
        echo "   時 gitleaks 讀工作樹 .gitleaks.toml、依放寬後設定放行)。"
        echo "   → 修法:先把 .gitleaks.toml 改動 push 走 PR、合入 protected branch,"
        echo "     再 push 這批 commit"
        echo "   → 緊急逃生:\`git push --no-verify\`(CI 仍會掃)"
      } >&2
      exit 1
    fi
  done

  if command -v gitleaks >/dev/null 2>&1; then
    for range in "${SCAN_RANGES[@]}"; do
      # --ignore-gitleaks-allow:不認行內 `gitleaks:allow` 註解
      # -i /dev/null:不認 repo 內的 .gitleaksignore(放行只走版控的 .gitleaks.toml)
      # -m:讓 merge commit 對每個 parent 產生 diff(Codex R1 P1)。舊寫法未指定
      #    diff-merges variant → git log 對 merge commit 不輸出 patch → 在
      #    merge 解衝突時直接加、兩個 parent 都沒有的密鑰不會出現在 gitleaks
      #    收到的 patch 裡、push 就離機。`-m` 是最保守選(掃每一邊 parent)。
      # 輸出捕捉後失敗時完整印出(吞掉會讓人分不清「真 leak」vs「config 壞」vs 其他錯)
      if ! out=$(gitleaks git --redact --no-banner --ignore-gitleaks-allow -i /dev/null \
        --log-opts "-m $range" 2>&1); then
        {
          echo ""
          echo "✗ gitleaks 在 push 範圍 $range 失敗,擋下 push"
          echo "$out"
          echo ""
          echo "   誤報 → 按值加進 .gitleaks.toml allowlist(該檔算 code、要走 PR)再 push"
          echo "   行內 gitleaks:allow 與 .gitleaksignore 已刻意停用(提交者不能自己放行)"
          echo "   同批修改 .gitleaks.toml + 密鑰的攻擊 vector 已由 config-touched 檢查擋下"
          echo "   緊急逃生:\`git push --no-verify\`(CI 仍會掃到並擋 PR)"
        } >&2
        exit 1
      fi
    done
  elif [ "${SKIP_GITLEAKS_CHECK:-}" = "1" ]; then
    echo "ℹ️  未裝 gitleaks,已依 SKIP_GITLEAKS_CHECK=1 略過秘密掃描" >&2
  else
    {
      echo ""
      echo "✗ 本機沒有 gitleaks,擋下 push(密鑰不該在沒掃過的情況下離機)"
      echo "   安裝:brew install gitleaks"
      echo "   真的要在無掃描的情況下 push:SKIP_GITLEAKS_CHECK=1 git push …"
      echo "   或 \`git push --no-verify\`(CI 仍會掃)"
    } >&2
    exit 1
  fi
fi

# ── 2. 保護分支守衛 ─────────────────────────────────────────────────────
triggered=0
# multi-ref push 時把所有警告聚合,最後只 prompt 一次(避免「yes 是確認哪個」歧義)
WARNING_BUFFER=""

append_warning() {
  WARNING_BUFFER="${WARNING_BUFFER}${1}
"
}

for line in "${REF_LINES[@]}"; do
  # shellcheck disable=SC2086
  set -- $line
  local_sha="$2"
  remote_ref="$3"
  remote_sha="$4"

  case "$remote_ref" in
    refs/heads/develop | refs/heads/main) ;;
    *) continue ;;
  esac

  branch_name="${remote_ref#refs/heads/}"

  # 2a. 刪除保護分支 → 硬擋(不給互動確認;branch protection 也會擋,但別讓本機先送出去)
  if [ "$local_sha" = "$z40" ]; then
    {
      echo ""
      echo "✗ 擋下「刪除受保護分支 origin/${branch_name}」"
      echo "   這個操作沒有正當的日常情境。真的要做:\`git push --no-verify\`,並先想清楚。"
    } >&2
    exit 1
  fi

  # 2b. 新建保護分支 → fail-closed 要求確認
  if [ "$remote_sha" = "$z40" ]; then
    triggered=1
    append_warning ""
    append_warning "⚠️  偵測到新建 origin/${branch_name}(remote 端不存在),這是罕見操作"
    append_warning "   為避免重建 protected branch 繞過守門,要求確認"
    continue
  fi

  # 2c. 非 fast-forward(force-push / 改寫歷史)→ 要求確認
  #     舊版只看端點 diff,force-push 若「端點內容剛好一樣或只差文件」會被靜默放行。
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    triggered=1
    append_warning ""
    append_warning "⚠️  偵測到**非 fast-forward** push 到 origin/${branch_name}(force-push／改寫歷史)"
    append_warning "   遠端已有的 commit 會被丟棄或重寫,要求確認"
    continue
  fi

  # 2d. 算這次 push 動到的檔案。
  # 🔴 端點 diff **不夠**:commit A 新增 `evil.ts`、commit B 刪掉它,端點比較是空的
  #    → 舊寫法 `[ -z "$changed" ] && continue` 直接放行,兩個 code commit 無聲進了
  #    develop 的歷史。改成「端點 diff ∪ 逐 commit 檔案清單」。
  if ! changed=$( {
    git diff --name-only --no-renames "$remote_sha..$local_sha" 2>&1
    git log --format= --name-only --no-renames "$remote_sha..$local_sha" 2>&1
  } | sort -u); then
    triggered=1
    append_warning ""
    append_warning "⚠️  無法 diff ${remote_sha}..${local_sha}(stale remote?)"
    append_warning "   為避免 silently 放行 code 改動,要求確認"
    append_warning "   git diff 訊息:$changed"
    continue
  fi

  [ -z "$changed" ] && continue

  # 🔴 `printf '%s\n'` 而非 `echo`(Codex R1 P1):見 pre-commit 同段——`-n`/`-e`
  #    等檔名會被 Bash builtin echo 當 flag、輸出空 → default-deny 靜默放行。
  code_files=$(printf '%s\n' "$changed" | grep -Ev "$NON_CODE_PATTERN" || true)
  protected_docs=$(printf '%s\n' "$changed" | grep -E "$PROTECTED_DOCS" || true)

  if [ -z "$code_files" ] && [ -z "$protected_docs" ]; then
    continue # 全是純說明文字且不含 PR-only 文件 → 放行
  fi

  triggered=1
  append_warning ""
  append_warning "⚠️  偵測到 push 需要走 PR 的改動到 origin/$branch_name"
  append_warning "   程式碼與 PR-only 文件應走 feature/* 分支 + PR + CI,直接 push 會 bypass branch protection。"
  if [ -n "$code_files" ]; then
    append_warning ""
    append_warning "   code 檔案:"
    while IFS= read -r f; do
      [ -n "$f" ] && append_warning "     - $f"
    done <<< "$code_files"
  fi
  if [ -n "$protected_docs" ]; then
    append_warning ""
    append_warning "   PR-only 文件(策略／安全／SOP／ADR):"
    while IFS= read -r f; do
      [ -n "$f" ] && append_warning "     - $f"
    done <<< "$protected_docs"
  fi
done

if [ "$triggered" = "1" ]; then
  printf '%s' "$WARNING_BUFFER" >&2
  echo "" >&2
  echo "若確定要直接 push(例:緊急 hotfix),請輸入 yes 確認(其他任何輸入 abort):" >&2

  # 必須從 /dev/tty 讀,因為 stdin 被 git 占用傳 ref 資料
  if [ ! -t 0 ] && [ ! -r /dev/tty ]; then
    echo "✗ 非 interactive 環境且 /dev/tty 不可讀,abort。緊急時用 \`git push --no-verify\`" >&2
    exit 1
  fi
  # -t 60:ssh -T 等情境 /dev/tty 可讀但 read 會 hang,60 秒 timeout 自動 abort
  read -t 60 -r answer < /dev/tty || answer=""
  if [ "$answer" != "yes" ]; then
    echo "✗ 取消 push" >&2
    exit 1
  fi
  echo "→ 已確認,繼續 push" >&2
fi

exit 0
