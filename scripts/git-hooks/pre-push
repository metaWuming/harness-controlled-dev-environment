#!/usr/bin/env bash
#
# scripts/git-hooks/pre-push — push 前秘密掃描 + 保護分支守衛
#
# 做兩件事:
#   1. **本機 gitleaks**:CI 抓到時密鑰已離開這台機器 → push 前在本機掃才是第一層。
#      當專案的生產密鑰在 repo 內走 env 變數(Supabase service_role、OAuth secret、
#      DB URL 等)、CI 抓到時已離機,這第一道就是唯一能擋住的地方。
#   2. **保護分支守衛**:Admin push 保護分支會 bypass branch protection,訊息看起來
#      像錯誤但其實已經成功。
#
# 🔴 幾個修過的 P1 洞:
#   ① **逐 ref 掃「這次真的會離機的範圍」**(先收完 stdin,再對每個 ref 掃
#      `remote_sha..local_sha`)。
#      ⚠️ 注意:gitleaks 預設掃 repo 內所有 ref,舊寫法**其實不會漏**——但這個
#      改動的意義是把掃描範圍**對準**這次要離機的 commit:
#        · 快(只掃 push 範圍,不是每次都全史)
#        · 不會因為「本機另一個分支有 finding」而擋掉一個乾淨的 push
#        · 語意誠實:hook 的職責是「別讓密鑰離機」,那就掃離機的那些 commit
#      代價(刻意接受):已經在遠端的舊 leak 不會每次 push 都再擋一次——CI 的全史
#      掃描仍會擋 PR,那才是清理 history 的正確場合。
#   ② **gitleaks 的自助放行**:`gitleaks:allow` 行內註解與 `.gitleaksignore` 都能讓
#      提交者自己放行(官方 escape hatch)→ 加 `--ignore-gitleaks-allow` 且把 ignore
#      檔指到 `/dev/null`,放行一律只走版控的 `.gitleaks.toml`(那份現在也算 code、
#      要走 PR)。
#   ③ **沒裝 gitleaks 就放行**:與「密鑰不離機」相反 → 改 fail-closed,要繞得明確設
#      `SKIP_GITLEAKS_CHECK=1`(或 `--no-verify`)。
#   ④ **刪除保護分支被無條件跳過** + force-push 可能因端點 diff 為空/docs-only 而
#      放行 → 刪除保護分支直接硬擋;非 fast-forward 一律要求確認。
#   ⑤ pre-push 完全沒套 PROTECTED_DOCS(策略/安全/SOP/ADR)→ 現在共用 SSOT 並套用。
#
# Hook 行為:
#   - 先掃這次要離機的所有 commit;有 leak → 硬 block
#   - push target 不是 develop / main → 放行(feature/* 都正常)
#   - 刪除 develop / main → **硬 block**
#   - push target 是 develop / main 但這批 commit 只動純說明文字(且不含
#     PROTECTED_DOCS)→ 放行(對應 progress / TODOS / LESSONS 收尾慣例)
#   - 其餘(含 code、含 PROTECTED_DOCS、新建保護分支、非 fast-forward、diff 取不到)
#     → 要求打字 yes 確認
#
# 緊急逃生:`git push --no-verify`
# Opt-in:`npm run setup-hooks`(設 git config core.hooksPath)

# `set -u`:見 pre-commit 同段——SSOT 變數被改名時,只有 `set -e` 會讓兩支 hook
# 靜默放行。壞掉的守門必須擋。
set -eu

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/git-hooks/code-pattern.sh
. "$HOOK_DIR/code-pattern.sh"

: "${NON_CODE_PATTERN:?code-pattern.sh 沒有定義 NON_CODE_PATTERN(守門失效,拒絕放行)}"
: "${PROTECTED_DOCS:?code-pattern.sh 沒有定義 PROTECTED_DOCS(守門失效,拒絕放行)}"

z40='0000000000000000000000000000000000000000'

# 🔴 R3 F2 修:git pre-push argv[1] = remote name (目的地),argv[2] = url。
#    後續用 `--remotes=$REMOTE_NAME` 只扣掉目的地的 tracking refs、避免
#    其他 remote (fork/upstream) 的 refs 把「本次真的要離機到 origin」
#    的 commits 誤扣掉。git 未提供 remote 時 default 'origin' (常見情境:
#    hook 手動觸發、init/setup 腳本)。
REMOTE_NAME="${1:-origin}"

# ── 先把 stdin 全部收進來 ────────────────────────────────────────────────
# Git 透過 stdin 傳 "<local-ref> <local-sha> <remote-ref> <remote-sha>",一行一個 ref。
# gitleaks 要按 ref 掃,所以不能邊讀邊處理(洞 ①)。
REF_LINES=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  REF_LINES+=("$local_ref $local_sha $remote_ref $remote_sha")
done

[ ${#REF_LINES[@]} -eq 0 ] && exit 0

# ── 1. 本機秘密掃描(只掃這次會離機的 commit 範圍)──────────────────────
#
# 🔴 range 內含空白(新 ref 用 `<sha> --not --remotes`)是刻意設計。呼叫端一律
#    用 `set -- $range` 位置參數 split(而非 `"$range"` 引號傳入)。內容都是本
#    hook 自己塞的 sha 或 rev-list expression、沒有外部輸入,shell splitting 安全。
SCAN_RANGES=()
for line in "${REF_LINES[@]}"; do
  # shellcheck disable=SC2086  # 刻意讓空白切成四個位置參數
  set -- $line
  _local_sha="$2"
  _remote_sha="$4"
  [ "$_local_sha" = "$z40" ] && continue # 刪除 ref:沒有新 commit 離機
  if [ "$_remote_sha" = "$z40" ] || ! git cat-file -e "${_remote_sha}^{commit}" 2>/dev/null; then
    # 🔴 R2 F3 修:新 ref (或 stale/force remote) 用 `--not --remotes` 只掃「這次
    #    真的新離機」的 commits。舊寫法 `SCAN_RANGES+=("$_local_sha")` 走整條
    #    ancestry → 若 repo 祖先某處曾 commit .gitleaks.toml,config-touched 段會
    #    match 到、任何 `git push -u origin feature/foo` 都被擋。
    #    `--not --remotes` = reachable from local_sha but not from any remote-
    #    tracking ref = 這次真的要離機的 commits(且新 clone 因 remotes 已完整、
    #    語意也對)。
    # 🔴 R3 F2 修:用 `--remotes=$REMOTE_NAME` 只扣掉本次目的地 remote 的 tracking
    #    refs,不是所有 remotes。若用 `--remotes` (無 pattern) 扣掉 fork/upstream 的
    #    refs,可能把「本次真的要離機到 origin」的 commits 也排除。
    SCAN_RANGES+=("$_local_sha --not --remotes=$REMOTE_NAME")
  else
    SCAN_RANGES+=("${_remote_sha}..${_local_sha}")
  fi
done

# 🔴 R2 F1 + R3 F1 修:取「可信 baseline」的 gitleaks config,而非讓 gitleaks 讀
#    當前工作樹的 `.gitleaks.toml`(dirty)或環境變數。從 `refs/remotes/$REMOTE_NAME/HEAD`
#    取 config、寫 tmpfile、`--config` 指定;找不到則寫合成 config 啟用 gitleaks
#    default rules;mktemp/寫失敗一律 return 1、hook 主流程 exit 1 fail-closed。
#    ⚠️ R3 F1:早期版本 fallback 用 `/dev/null` → gitleaks 讀空 TOML = 0 rules =
#       全放行。實測 gitleaks 8.30.1 對 `--config /dev/null` 就是「無規則」不
#       是「default rules」。正解是寫入 `[extend]\nuseDefault = true` 才啟用
#       gitleaks 內建規則集。
#    ⚠️ Command substitution 會清 subshell errexit,不能靠 `set -e` fail-closed,
#       所以 helper 內每一步都要顯式檢查、失敗顯式 return 1。
resolve_trusted_gitleaks_config() {
  local tmp
  tmp=$(mktemp -t hook-gitleaks-config.XXXXXX) || return 1
  # 先寫合成 baseline (啟用 gitleaks default rules),之後若能覆蓋成 remote config 更好
  if ! printf '[extend]\nuseDefault = true\n' > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi

  # 嘗試從目的地 remote HEAD 取專案 config;取得且非空才覆蓋 synthetic fallback
  local remote_head_ref="refs/remotes/$REMOTE_NAME/HEAD"
  if git symbolic-ref --quiet "$remote_head_ref" >/dev/null 2>&1; then
    local project_config
    project_config=$(mktemp -t hook-gitleaks-project.XXXXXX) || {
      rm -f "$tmp"
      return 1
    }
    if git show "$remote_head_ref:.gitleaks.toml" >"$project_config" 2>/dev/null && \
      [ -s "$project_config" ]; then
      # 專案自帶 config → 覆蓋 synthetic (gitleaks 讀專案 config;若專案有 [extend]
      # useDefault 也生效)
      mv -f "$project_config" "$tmp" || {
        rm -f "$tmp" "$project_config"
        return 1
      }
    else
      rm -f "$project_config"
    fi
  fi

  printf '%s\n' "$tmp"
  return 0
}

# 🔴 R3 F4 修:EXIT 只涵蓋正常結束與 `exit`,不涵蓋 INT/TERM/HUP → Ctrl-C 時
#    tmp config (可能含專案 sensitive rules) 殘留。轉發這些 signal 為 exit 讓
#    EXIT cleanup 執行。SIGKILL 無法攔截 (接受)。
# shellcheck disable=SC2329  # 由 trap EXIT/INT/TERM/HUP 呼叫,shellcheck 抓不到
cleanup_trusted_config() {
  [ -n "${trusted_config:-}" ] && [ "$trusted_config" != "/dev/null" ] && \
    rm -f "$trusted_config"
}
trap 'cleanup_trusted_config' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

if [ ${#SCAN_RANGES[@]} -gt 0 ]; then
  # 🔴 攻擊 vector 擋(R1 F2 + R2 F2 修):push 範圍同批修改 `.gitleaks.toml` /
  #    `.gitleaksignore` → 直接硬擋。與 R2 F1 的「可信 config」修法互補:那條擋
  #    dirty worktree config,這條擋「先加寬 allowlist 再加密鑰」的合批 commit
  #    攻擊(config 若走 PR 合入 protected branch,那條路仍暢通)。
  #    🔴 R2 F2 修:加 `-m` 讓 merge commit 對每個 parent 產生 diff。原修法漏
  #       了、attacker 可在 merge resolution 只帶入 config 放寬(兩 parent 都沒有)
  #       → config-touched 看不到,而 gitleaks 用 R2 F1 的可信 config 也擋得住,
  #       但這裡若走的是「未來把 config 也走 PR」情境,merge 帶入的變更仍是繞道。
  for range in "${SCAN_RANGES[@]}"; do
    # 🔴 R3 F3 修:拆 pipeline、每階段顯式檢查、失敗 fail-closed。原寫法
    #    `... | grep ... | sort -u || true` 若 git log/sort 因 TMPDIR 不可寫或
    #    磁碟不足 fail、`|| true` 讓整條回空 → hook 繼續(fail-open)。改用 awk
    #    streaming dedupe 避免 sort spill、並顯式檢查 PIPESTATUS。
    # shellcheck disable=SC2086  # range 內含 --not --remotes 等 args,刻意 split
    log_out=$(git log --format= --name-only --no-renames -m $range 2>/dev/null)
    log_ec=$?
    if [ $log_ec -ne 0 ]; then
      {
        echo ""
        echo "✗ git log 對 push 範圍「$range」失敗 (ec=$log_ec),擋下 push"
        echo "   → 這通常是 stale remote-tracking ref 或 corrupted range,\`git fetch --prune\` 後重試"
        echo "   → 緊急逃生:\`git push --no-verify\`(CI 仍會掃)"
      } >&2
      exit 1
    fi
    config_touched=$(printf '%s\n' "$log_out" | \
      awk '/^\.gitleaks\.toml$|^\.gitleaksignore$/ && !seen[$0]++')
    if [ -n "$config_touched" ]; then
      {
        echo ""
        echo "✗ push 範圍「$range」同批修改 gitleaks 設定,擋下 push"
        echo "   影響檔案:"
        while IFS= read -r f; do
          [ -n "$f" ] && echo "     - $f"
        done <<< "$config_touched"
        echo ""
        echo "   同批放寬 allowlist ＋加密鑰是已知攻擊 vector。"
        echo "   → 修法:先把 .gitleaks.toml 改動 push 走 PR、合入 protected branch,"
        echo "     再 push 這批 commit"
        echo "   → 緊急逃生:\`git push --no-verify\`(CI 仍會掃)"
      } >&2
      exit 1
    fi
  done

  if command -v gitleaks >/dev/null 2>&1; then
    # 🔴 R2 F1 修:顯式清掉可能覆寫 --config 的 env(gitleaks 官方優先序
    #    --config → GITLEAKS_CONFIG → GITLEAKS_CONFIG_TOML → 工作樹 .gitleaks.toml)。
    unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML
    # 🔴 R3 F1 修:resolver 失敗一律 fail-closed。不能繼續用工作樹 dirty config
    #    或空 config,那正是要擋掉的 vector。
    if ! trusted_config=$(resolve_trusted_gitleaks_config); then
      {
        echo ""
        echo "✗ 無法建立可信 gitleaks config (mktemp/write 失敗),擋下 push"
        echo "   → 檢查 \$TMPDIR 可寫、磁碟未滿"
        echo "   → 緊急逃生:\`git push --no-verify\`(CI 仍會掃)"
      } >&2
      exit 1
    fi
    # cleanup_trusted_config 已在檔頭 trap 過(涵蓋 EXIT + INT/TERM/HUP);此處
    # 不再重新裝 trap,避免覆蓋掉 signal 版。

    for range in "${SCAN_RANGES[@]}"; do
      # --config "$trusted_config":R2 F1,顯式從 origin/HEAD 取,不用工作樹
      # --ignore-gitleaks-allow:不認行內 `gitleaks:allow` 註解
      # -i /dev/null:不認 repo 內的 .gitleaksignore
      # -m:merge commit 對每個 parent 產 diff(R1 F3)
      # 輸出捕捉後失敗時完整印出(吞掉會讓人分不清「真 leak」vs「config 壞」vs 其他錯)
      if ! out=$(gitleaks git --config "$trusted_config" --redact --no-banner \
        --ignore-gitleaks-allow -i /dev/null --log-opts "-m $range" 2>&1); then
        {
          echo ""
          echo "✗ gitleaks 在 push 範圍「$range」失敗,擋下 push"
          echo "$out"
          echo ""
          echo "   config 使用可信 baseline: $trusted_config"
          echo "         (從 refs/remotes/$REMOTE_NAME/HEAD:.gitleaks.toml,或 fallback 到 gitleaks default rules)"
          echo "   誤報 → 按值加進 .gitleaks.toml allowlist(該檔算 code、要走 PR、合入"
          echo "         protected branch 之後才會被 pre-push 認)再 push"
          echo "   行內 gitleaks:allow / .gitleaksignore / 工作樹 dirty config / env 覆寫皆已停用"
          echo "   緊急逃生:\`git push --no-verify\`(CI 仍會掃到並擋 PR)"
        } >&2
        exit 1
      fi
    done
  elif [ "${SKIP_GITLEAKS_CHECK:-}" = "1" ]; then
    echo "ℹ️  未裝 gitleaks,已依 SKIP_GITLEAKS_CHECK=1 略過秘密掃描" >&2
  else
    {
      echo ""
      echo "✗ 本機沒有 gitleaks,擋下 push(密鑰不該在沒掃過的情況下離機)"
      echo "   安裝:brew install gitleaks"
      echo "   真的要在無掃描的情況下 push:SKIP_GITLEAKS_CHECK=1 git push …"
      echo "   或 \`git push --no-verify\`(CI 仍會掃)"
    } >&2
    exit 1
  fi
fi

# ── 2. 保護分支守衛 ─────────────────────────────────────────────────────
triggered=0
# multi-ref push 時把所有警告聚合,最後只 prompt 一次(避免「yes 是確認哪個」歧義)
WARNING_BUFFER=""

append_warning() {
  WARNING_BUFFER="${WARNING_BUFFER}${1}
"
}

for line in "${REF_LINES[@]}"; do
  # shellcheck disable=SC2086
  set -- $line
  local_sha="$2"
  remote_ref="$3"
  remote_sha="$4"

  case "$remote_ref" in
    refs/heads/develop | refs/heads/main) ;;
    *) continue ;;
  esac

  branch_name="${remote_ref#refs/heads/}"

  # 2a. 刪除保護分支 → 硬擋(不給互動確認;branch protection 也會擋,但別讓本機先送出去)
  if [ "$local_sha" = "$z40" ]; then
    {
      echo ""
      echo "✗ 擋下「刪除受保護分支 origin/${branch_name}」"
      echo "   這個操作沒有正當的日常情境。真的要做:\`git push --no-verify\`,並先想清楚。"
    } >&2
    exit 1
  fi

  # 2b. 新建保護分支 → fail-closed 要求確認
  if [ "$remote_sha" = "$z40" ]; then
    triggered=1
    append_warning ""
    append_warning "⚠️  偵測到新建 origin/${branch_name}(remote 端不存在),這是罕見操作"
    append_warning "   為避免重建 protected branch 繞過守門,要求確認"
    continue
  fi

  # 2c. 非 fast-forward(force-push / 改寫歷史)→ 要求確認
  #     舊版只看端點 diff,force-push 若「端點內容剛好一樣或只差文件」會被靜默放行。
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    triggered=1
    append_warning ""
    append_warning "⚠️  偵測到**非 fast-forward** push 到 origin/${branch_name}(force-push／改寫歷史)"
    append_warning "   遠端已有的 commit 會被丟棄或重寫,要求確認"
    continue
  fi

  # 2d. 算這次 push 動到的檔案。
  # 🔴 端點 diff **不夠**:commit A 新增 `evil.ts`、commit B 刪掉它,端點比較是空的
  #    → 舊寫法 `[ -z "$changed" ] && continue` 直接放行,兩個 code commit 無聲進了
  #    develop 的歷史。改成「端點 diff ∪ 逐 commit 檔案清單」。
  if ! changed=$( {
    git diff --name-only --no-renames "$remote_sha..$local_sha" 2>&1
    git log --format= --name-only --no-renames "$remote_sha..$local_sha" 2>&1
  } | sort -u); then
    triggered=1
    append_warning ""
    append_warning "⚠️  無法 diff ${remote_sha}..${local_sha}(stale remote?)"
    append_warning "   為避免 silently 放行 code 改動,要求確認"
    append_warning "   git diff 訊息:$changed"
    continue
  fi

  [ -z "$changed" ] && continue

  # 🔴 `printf '%s\n'` 而非 `echo`(Codex R1 P1):見 pre-commit 同段——`-n`/`-e`
  #    等檔名會被 Bash builtin echo 當 flag、輸出空 → default-deny 靜默放行。
  code_files=$(printf '%s\n' "$changed" | grep -Ev "$NON_CODE_PATTERN" || true)
  protected_docs=$(printf '%s\n' "$changed" | grep -E "$PROTECTED_DOCS" || true)

  if [ -z "$code_files" ] && [ -z "$protected_docs" ]; then
    continue # 全是純說明文字且不含 PR-only 文件 → 放行
  fi

  triggered=1
  append_warning ""
  append_warning "⚠️  偵測到 push 需要走 PR 的改動到 origin/$branch_name"
  append_warning "   程式碼與 PR-only 文件應走 feature/* 分支 + PR + CI,直接 push 會 bypass branch protection。"
  if [ -n "$code_files" ]; then
    append_warning ""
    append_warning "   code 檔案:"
    while IFS= read -r f; do
      [ -n "$f" ] && append_warning "     - $f"
    done <<< "$code_files"
  fi
  if [ -n "$protected_docs" ]; then
    append_warning ""
    append_warning "   PR-only 文件(策略／安全／SOP／ADR):"
    while IFS= read -r f; do
      [ -n "$f" ] && append_warning "     - $f"
    done <<< "$protected_docs"
  fi
done

if [ "$triggered" = "1" ]; then
  printf '%s' "$WARNING_BUFFER" >&2
  echo "" >&2
  echo "若確定要直接 push(例:緊急 hotfix),請輸入 yes 確認(其他任何輸入 abort):" >&2

  # 必須從 /dev/tty 讀,因為 stdin 被 git 占用傳 ref 資料
  if [ ! -t 0 ] && [ ! -r /dev/tty ]; then
    echo "✗ 非 interactive 環境且 /dev/tty 不可讀,abort。緊急時用 \`git push --no-verify\`" >&2
    exit 1
  fi
  # -t 60:ssh -T 等情境 /dev/tty 可讀但 read 會 hang,60 秒 timeout 自動 abort
  read -t 60 -r answer < /dev/tty || answer=""
  if [ "$answer" != "yes" ]; then
    echo "✗ 取消 push" >&2
    exit 1
  fi
  echo "→ 已確認,繼續 push" >&2
fi

exit 0
