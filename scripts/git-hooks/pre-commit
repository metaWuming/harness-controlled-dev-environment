#!/usr/bin/env bash
#
# scripts/git-hooks/pre-commit — 保護分支(develop / main)程式碼 commit 守衛
#
# 機器化「commit 前必重驗 branch」教訓:實務常見「背景 agent / 平行 session 偷移
# HEAD → commit 落到保護分支」——防線若只有記憶提醒擋不住,本 hook 把它變成機器擋。
#
# Hook 行為:
#   - 當前分支不是 develop / main → 直接放行(feature/* 零摩擦)
#   - develop / main 上 staged 檔案全是純說明文字(.md / 指定資料夾內 .html)→ 放行
#     (保留「feature merge 後直接 commit progress/TODOS/LESSONS doc」慣例)
#   - develop / main 上 staged 含 code 檔 → **直接 block**(不做互動確認——
#     程式碼 commit 到保護分支沒有正當情境;pre-push 的互動確認是給「push 既有
#     commit」的罕見情境,commit 當下攔截更早更便宜)
#   - 例外中的例外:PROTECTED_DOCS(策略／安全／SOP／ADR)雖是 .md 也一樣 block
#   - **任何分支**:staged 含 TOOL_ARTIFACT_PATTERN(本機 AI / 工具產物,`.codegraph/` 等)
#     → block(`git add -A` 誤加 untracked 的機器化守門;.gitignore 是第一道、本 hook 是縱深)
#
# 覆蓋邊界(誠實揭露):git 只對 `git commit` 跑 pre-commit。
#   `git merge --no-ff`、`git cherry-pick`、`git revert`、`git am`(走 pre-applypatch)
#   **都不會觸發本 hook**。那幾條路的最後一道是 pre-push 的互動確認(不是硬擋)。
#   所以本 hook 是「把最常見的那條路做成硬擋」,不是全覆蓋。
#
# 🔴 `--no-renames`:`git diff --cached --name-only` 對 rename 只回報**目的路徑** →
#    把 `SPEC.md` rename 成 `docs/notes.md` 就繞過 PROTECTED_DOCS。加 `--no-renames`
#    後 rename 拆成 delete + add,兩端都列出。
#
# 🔴 `set -u`:只有 `set -e` 時,把 SSOT 裡的變數改名／打錯字會讓 `grep -Ev ""`
#    反轉成「輸出空」→ `code_files` 空 → **hook 靜默放行**(實測 rc=0)。
#    壞掉的守門必須擋,不能放行 → `set -u` + 下面的 `:?` 斷言。
#
# 緊急逃生:`git commit --no-verify` 跳過本 hook
# Opt-in:`npm run setup-hooks`(設 git config core.hooksPath;已設者自動生效)

set -eu

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/git-hooks/code-pattern.sh
. "$HOOK_DIR/code-pattern.sh"

# SSOT 必須提供這三個變數且非空;缺一個就中止(fail-closed)
: "${NON_CODE_PATTERN:?code-pattern.sh 沒有定義 NON_CODE_PATTERN(守門失效,拒絕放行)}"
: "${PROTECTED_DOCS:?code-pattern.sh 沒有定義 PROTECTED_DOCS(守門失效,拒絕放行)}"
: "${TOOL_ARTIFACT_PATTERN:?code-pattern.sh 沒有定義 TOOL_ARTIFACT_PATTERN(守門失效,拒絕放行)}"

# staged 檔案清單(--cached = 只看這次 commit 會進去的東西;--no-renames 見檔頭)
staged="$(git diff --cached --name-only --no-renames)"
[ -z "$staged" ] && exit 0

# 0) 任何分支:本機 AI / 工具產物不得進 commit(`git add -A` 誤加 untracked 的機器化守門)
artifacts=$(printf '%s\n' "$staged" | grep -E "$TOOL_ARTIFACT_PATTERN" || true)
if [ -n "$artifacts" ]; then
  {
    echo ""
    echo "✗ 擋下 commit:staged 含本機工具產物(TOOL_ARTIFACT_PATTERN),多半是 \`git add -A\` / \`git add .\` 掃進來的"
    echo ""
    echo "   被擋的檔案:"
    while IFS= read -r line; do
      [ -n "$line" ] && echo "     - $line"
    done <<< "$artifacts"
    echo ""
    echo "   → 修法:\`git restore --staged <路徑>\`,之後 \`git add\` 列具體檔名、不用 -A / .(先 \`git status --short\` 看 ?? 行)"
    echo "   → 這些路徑應在 .gitignore;若你的工具產物不同,改 scripts/git-hooks/code-pattern.sh 的 TOOL_ARTIFACT_PATTERN"
    echo "   → 緊急逃生:\`git commit --no-verify\`"
  } >&2
  exit 1
fi

branch="$(git branch --show-current 2>/dev/null || true)"

# 以下只在保護分支上作用(detached HEAD → branch 為空 → 放行,rebase 等情境不干擾)
case "$branch" in
  develop|main) ;;
  *) exit 0 ;;
esac

blocked=""

# 🔴 用 `printf '%s\n'` 而非 `echo`(Codex R1 P1):Bash builtin `echo` 會把
#    `-n` / `-e` / `-E` 這類檔名當成選項吃掉、輸出空 → `grep -Ev` 收到空輸入 →
#    `code_files` 空 → default-deny 靜默放行。合法檔名叫這些字元罕見但可能,
#    default-deny 就是要處理極端。`printf '%s\n'` 對第一個 argument 一律當字面。

# 1) code 檔一律 block(default-deny:非 .md / 非 docs/*.html 就是 code)
code_files=$(printf '%s\n' "$staged" | grep -Ev "$NON_CODE_PATTERN" || true)
[ -n "$code_files" ] && blocked="$code_files"

# 2) PROTECTED_DOCS 內的 PR-only 治理／安全／spec 文件,.md 也不放行
protected=$(printf '%s\n' "$staged" | grep -E "$PROTECTED_DOCS" || true)
if [ -n "$protected" ]; then
  blocked="${blocked}${blocked:+
}$protected"
fi

if [ -n "$blocked" ]; then
  {
    echo ""
    echo "✗ 擋下 commit 到 ${branch}(「commit 前必重驗 branch」機器化)"
    echo "   程式碼(與 PR-only 的策略／安全／SOP／ADR 文件)不能直接 commit 到保護分支——走 feature 分支 + PR。"
    echo ""
    echo "   被擋的檔案:"
    while IFS= read -r line; do
      [ -n "$line" ] && echo "     - $line"
    done <<< "$blocked"
    echo ""
    echo "   → 修法:\`git checkout -b feature/<名稱>\`(staged 檔案會原封不動跟著過去),再 commit"
    echo "   → 可直接 commit 的:純說明文字 .md、docs/*.html runbook"
    echo "   → 緊急逃生:\`git commit --no-verify\`"
  } >&2
  exit 1
fi

exit 0
